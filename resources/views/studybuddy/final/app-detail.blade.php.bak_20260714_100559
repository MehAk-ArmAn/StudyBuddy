        $clean = ltrim($path, '/');
        return file_exists(public_path($clean)) ? asset($clean) : null;
    };

    $firstExisting = function (array $paths) use ($assetUrl) {
        foreach ($paths as $path) {
            $url = $assetUrl($path);
