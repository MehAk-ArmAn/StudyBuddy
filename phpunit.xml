<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd" bootstrap="vendor/autoload.php" colors="true">
    <testsuites>
        <testsuite name="Feature"><directory>tests/Feature</directory></testsuite>
        <testsuite name="Unit"><directory>tests/Unit</directory></testsuite>
    </testsuites>
    <!-- ignoreIndirectDeprecations hides deprecations raised inside vendor code
         (Laravel 11 uses PDO::MYSQL_ATTR_SSL_CA, which PHP 8.5 deprecates) so
         that deprecations coming from app/ still stand out. -->
    <source ignoreIndirectDeprecations="true">
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <!-- Tests always run against a throwaway in-memory database so a test
             run can never touch development or production data. -->
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
    </php>
</phpunit>
