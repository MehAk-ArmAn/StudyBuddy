:root {
    --sb-dark-bg: #050816;
    --sb-dark-panel: rgba(11, 18, 38, .78);
    --sb-dark-panel-strong: rgba(13, 21, 48, .92);
    --sb-dark-card: rgba(255,255,255,.075);
    --sb-dark-card-hover: rgba(255,255,255,.105);
    --sb-dark-line: rgba(255,255,255,.13);
    --sb-dark-text: #f8fbff;
    --sb-dark-muted: rgba(226,232,240,.72);
    --sb-dark-soft: rgba(226,232,240,.56);
    --sb-cyan: #22d3ee;
    --sb-purple: #7c3cff;
    --sb-blue: #246bff;
}

.sb-connected-apps,
.sb-app-detail-world,
.sb-connected-apps *,
.sb-app-detail-world * {
    box-sizing: border-box;
}

.sb-connected-apps,
.sb-app-detail-world {
    min-height: 100vh;
    overflow: hidden;
    color: var(--sb-dark-text);
    background:
        radial-gradient(circle at 8% 0%, rgba(34, 211, 238, .16), transparent 34%),
        radial-gradient(circle at 90% 4%, rgba(124, 60, 255, .22), transparent 38%),
        radial-gradient(circle at 45% 35%, color-mix(in srgb, var(--app-one, #7c3cff) 16%, transparent), transparent 38%),
        linear-gradient(180deg, #050816 0%, #081026 44%, #050816 100%);
}

.sb-apps-landing,
.sb-apps-toolbar,
.sb-apps-note,
.sb-connected-grid,
.sb-detail-hero,
.sb-detail-strip,
.sb-detail-section,
.sb-empty-apps {
    width: min(100%, 1180px);
    margin-inline: auto;
    padding-inline: clamp(16px, 4vw, 28px);
}

.sb-apps-landing,
.sb-detail-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, .72fr);
    gap: clamp(28px, 5vw, 56px);
    align-items: center;
    padding-top: clamp(44px, 8vw, 92px);
    padding-bottom: clamp(28px, 6vw, 66px);
}

.sb-apps-landing::before,
.sb-detail-hero::before {
    content: "";
    position: absolute;
    inset: 20px 18px;
    z-index: 0;
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 42px;
    background:
        radial-gradient(circle at 14% 16%, color-mix(in srgb, var(--app-one, #7c3cff) 18%, transparent), transparent 28%),
        radial-gradient(circle at 84% 20%, rgba(34,211,238,.12), transparent 30%),
        rgba(255,255,255,.035);
    pointer-events: none;
}

.sb-apps-landing > *,
.sb-detail-hero > * {
    position: relative;
    z-index: 1;
}

.sb-apps-kicker {
    margin: 0 0 10px;
    color: var(--app-three, var(--sb-cyan));
    font-size: .78rem;
    font-weight: 950;
    letter-spacing: .13em;
    text-transform: uppercase;
}

.sb-apps-landing h1,
.sb-detail-copy h1 {
    max-width: 820px;
    margin: 0;
    color: var(--sb-dark-text);
    font-size: clamp(2.4rem, 7vw, 5.6rem);
    line-height: .88;
    letter-spacing: -.08em;
    overflow-wrap: anywhere;
}

.sb-apps-landing p,
.sb-detail-copy p,
.sb-detail-section p,
.sb-connected-card p {
    color: var(--sb-dark-muted);
    line-height: 1.72;
    overflow-wrap: anywhere;
}

.sb-apps-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
}

.sb-apps-actions a,
.sb-connected-links a,
.sb-connected-links span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 999px;
    padding: 11px 16px;
    color: white;
    background: linear-gradient(135deg, var(--app-one, var(--sb-purple)), var(--app-two, var(--sb-blue)));
    text-decoration: none;
    font-weight: 950;
    box-shadow: 0 18px 38px rgba(2,6,23,.34);
    transition: transform .22s ease, box-shadow .22s ease, filter .22s ease;
}

.sb-apps-actions a:hover,
.sb-connected-links a:hover {
    transform: translateY(-3px);
    filter: brightness(1.08);
    box-shadow: 0 24px 54px color-mix(in srgb, var(--app-one, #7c3cff) 30%, transparent);
}

.sb-apps-actions .soft,
.sb-connected-links .soft {
    color: var(--sb-dark-text);
    background: rgba(255,255,255,.09);
}

.sb-apps-count-card {
    border: 1px solid rgba(255,255,255,.13);
    border-radius: 36px;
    padding: clamp(24px, 4vw, 38px);
    background:
        radial-gradient(circle at 50% 0%, rgba(34,211,238,.14), transparent 38%),
        var(--sb-dark-panel);
    box-shadow: 0 30px 90px rgba(2,6,23,.36);
    backdrop-filter: blur(18px);
    text-align: center;
}

.sb-apps-count-card span {
    font-size: 3rem;
}

.sb-apps-count-card strong {
    display: block;
    color: white;
    font-size: 4rem;
    line-height: .9;
}

.sb-apps-count-card p {
    color: var(--sb-dark-muted);
}

.sb-apps-toolbar {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(160px, .55fr) minmax(160px, .55fr);
    gap: 14px;
    margin-bottom: 14px;
}

.sb-apps-toolbar label {
    display: grid;
    gap: 7px;
    min-width: 0;
    color: var(--sb-dark-soft);
    font-size: .78rem;
    font-weight: 950;
    letter-spacing: .1em;
    text-transform: uppercase;
}

.sb-apps-toolbar input,
.sb-apps-toolbar select {
    min-width: 0;
    min-height: 52px;
    border: 1px solid rgba(255,255,255,.13);
    border-radius: 20px;
    padding: 0 14px;
    color: var(--sb-dark-text);
    background: rgba(255,255,255,.075);
    box-shadow: 0 18px 44px rgba(2,6,23,.22);
    font: inherit;
    font-weight: 850;
    outline: none;
}

.sb-apps-toolbar input::placeholder {
    color: rgba(226,232,240,.48);
}

.sb-apps-toolbar input:focus,
.sb-apps-toolbar select:focus {
    border-color: color-mix(in srgb, var(--app-three, #22d3ee) 52%, white);
    box-shadow: 0 0 0 4px rgba(34,211,238,.12), 0 18px 44px rgba(2,6,23,.22);
}

.sb-apps-toolbar select option {
    color: #07111f;
    background: #ffffff;
}

.sb-apps-note,
.sb-empty-apps {
    border: 1px solid rgba(255,255,255,.11);
    border-radius: 24px;
    padding-block: 16px;
    margin-bottom: 22px;
    color: var(--sb-dark-muted);
    background: rgba(255,255,255,.06);
    box-shadow: 0 18px 44px rgba(2,6,23,.22);
}

.sb-apps-note strong,
.sb-empty-apps strong {
    color: white;
}

.sb-connected-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    padding-bottom: 44px;
}

.sb-connected-card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,.115);
    border-radius: 34px;
    background:
        radial-gradient(circle at var(--mx, 50%) var(--my, 0%), color-mix(in srgb, var(--app-three) 20%, transparent), transparent 34%),
        linear-gradient(180deg, rgba(255,255,255,.095), rgba(255,255,255,.055));
    box-shadow: 0 24px 72px rgba(2,6,23,.30);
    backdrop-filter: blur(18px);
    transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease, background .22s ease;
}

.sb-connected-card:hover {
    transform: translateY(-7px);
    border-color: color-mix(in srgb, var(--app-three) 42%, white);
    background:
        radial-gradient(circle at var(--mx, 50%) var(--my, 0%), color-mix(in srgb, var(--app-three) 26%, transparent), transparent 34%),
        linear-gradient(180deg, rgba(255,255,255,.125), rgba(255,255,255,.075));
    box-shadow: 0 34px 92px rgba(2,6,23,.42);
}

.sb-connected-media {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 230px;
    padding: 24px;
    background:
        radial-gradient(circle at 50% 46%, color-mix(in srgb, var(--app-three) 32%, transparent), transparent 45%),
        radial-gradient(circle at 15% 0%, color-mix(in srgb, var(--app-one) 18%, transparent), transparent 36%),
        linear-gradient(135deg, rgba(255,255,255,.08), rgba(255,255,255,.035));
}

.sb-connected-media::after {
    content: "";
    position: absolute;
    inset: auto 24px 18px;
    height: 16px;
    border-radius: 50%;
    background: rgba(0,0,0,.34);
    filter: blur(14px);
}

.sb-connected-media img {
    position: relative;
    z-index: 1;
    width: min(100%, 210px);
    height: 190px;
    object-fit: contain;
    filter: drop-shadow(0 24px 30px rgba(0,0,0,.32));
    transition: transform .25s ease;
}

.sb-connected-card:hover .sb-connected-media img {
    transform: translateY(-6px) scale(1.035);
}

.sb-connected-media > span {
    position: absolute;
    right: 18px;
    top: 18px;
    z-index: 2;
    min-width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(255,255,255,.16);
    border-radius: 18px;
    color: white;
    background: linear-gradient(135deg, var(--app-one), var(--app-two));
    font-weight: 950;
    box-shadow: 0 16px 34px rgba(2,6,23,.28);
}

.sb-connected-card-body {
    padding: 22px;
}

.sb-connected-topline,
.sb-connected-meta,
.sb-role-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.sb-connected-topline {
    justify-content: space-between;
    align-items: center;
    color: var(--app-three);
    font-size: .76rem;
    font-weight: 950;
    letter-spacing: .1em;
    text-transform: uppercase;
}

.sb-connected-topline b,
.sb-connected-meta span,
.sb-role-chips span {
    border: 1px solid rgba(255,255,255,.09);
    border-radius: 999px;
    padding: 7px 9px;
    background: rgba(255,255,255,.075);
    color: rgba(226,232,240,.78);
    font-size: .75rem;
    font-weight: 900;
}

.sb-connected-card h2 {
    margin: 14px 0 6px;
    color: white;
    font-size: 1.65rem;
    letter-spacing: -.04em;
}

.sb-connected-card .tagline {
    margin: 0 0 8px;
    color: white;
    font-weight: 950;
}

.sb-connected-meta {
    margin-top: 14px;
}

.sb-connected-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
}

.sb-connected-card[hidden],
.sb-empty-apps[hidden] {
    display: none !important;
}

/* Detail page */
.sb-detail-hero {
    background:
        radial-gradient(circle at 50% 0%, color-mix(in srgb, var(--app-one) 18%, transparent), transparent 40%);
}

.sb-back-link {
    display: inline-flex;
    margin-bottom: 18px;
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 999px;
    padding: 10px 14px;
    color: var(--sb-dark-text);
    background: rgba(255,255,255,.08);
    text-decoration: none;
    font-weight: 950;
}

.sb-world-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
}

.sb-world-meta span {
    border: 1px solid rgba(255,255,255,.10);
    border-radius: 999px;
    padding: 10px 13px;
    color: var(--sb-dark-text);
    background: rgba(255,255,255,.075);
    font-weight: 900;
}

.sb-detail-art {
    position: relative;
    min-height: clamp(340px, 44vw, 500px);
    display: grid;
    place-items: center;
    border: 1px solid rgba(255,255,255,.14);
    border-radius: clamp(32px, 5vw, 54px);
    padding: clamp(24px, 4vw, 42px);
    background:
        radial-gradient(circle at var(--mx, 60%) var(--my, 20%), color-mix(in srgb, var(--app-three) 22%, transparent), transparent 34%),
        linear-gradient(180deg, rgba(255,255,255,.10), rgba(255,255,255,.055));
    box-shadow: 0 34px 100px rgba(2,6,23,.42);
    backdrop-filter: blur(20px);
    transform-style: preserve-3d;
}

.sb-detail-art .art-glow {
    position: absolute;
    inset: 12%;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--app-three) 36%, transparent), transparent 64%);
    filter: blur(28px);
    opacity: .72;
}

.sb-detail-art .main-art {
    position: relative;
    z-index: 2;
    width: min(100%, 400px);
    height: clamp(230px, 35vw, 400px);
    object-fit: contain;
    filter: drop-shadow(0 30px 42px rgba(0,0,0,.38));
}

.sb-detail-art > span {
    position: absolute;
    top: 22px;
    right: 22px;
    z-index: 3;
    min-width: 56px;
    height: 56px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(255,255,255,.16);
    border-radius: 20px;
    color: white;
    background: linear-gradient(135deg, var(--app-one), var(--app-two));
    font-weight: 950;
    box-shadow: 0 18px 38px rgba(2,6,23,.36);
}

.sb-detail-art .float,
.sb-detail-decor {
    position: absolute;
    object-fit: contain;
    pointer-events: none;
}

.sb-detail-art .orb {
    width: 110px;
    left: 14px;
    bottom: 20px;
}

.sb-detail-art .small-orb {
    width: 70px;
    right: 24px;
    bottom: 28px;
}

.sb-detail-art .spark {
    width: 54px;
    left: 18%;
    top: 14%;
    animation: sbFloat 4s ease-in-out infinite;
}

.sb-detail-decor.comet {
    width: clamp(120px, 22vw, 260px);
    right: 22%;
    top: 8%;
    opacity: .72;
}

.sb-detail-decor.star {
    width: 66px;
    left: 45%;
    top: 14%;
    animation: sbTwinkle 3s ease-in-out infinite;
}

.sb-detail-decor.planet {
    width: 116px;
    right: -22px;
    bottom: 14%;
}

.sb-detail-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin-bottom: 30px;
}

.sb-detail-strip article,
.sb-detail-section {
    border: 1px solid rgba(255,255,255,.11);
    background:
        radial-gradient(circle at 100% 0%, color-mix(in srgb, var(--app-three) 10%, transparent), transparent 32%),
        rgba(255,255,255,.065);
    box-shadow: 0 24px 72px rgba(2,6,23,.28);
    backdrop-filter: blur(18px);
}

.sb-detail-strip article {
    min-width: 0;
    border-radius: 26px;
    padding: 18px;
}

.sb-detail-strip span {
    color: var(--sb-dark-soft);
    font-size: .78rem;
    font-weight: 950;
    letter-spacing: .1em;
    text-transform: uppercase;
}

.sb-detail-strip strong {
    display: block;
    margin-top: 7px;
    color: white;
    overflow-wrap: anywhere;
}

.sb-detail-section {
    margin-bottom: 22px;
    border-radius: 34px;
    padding: clamp(24px, 4vw, 42px);
}

.sb-detail-section.split {
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
    gap: clamp(20px, 4vw, 40px);
}

.sb-detail-section h2 {
    margin: 0;
    color: white;
    font-size: clamp(1.8rem, 4vw, 3.1rem);
    line-height: .95;
    letter-spacing: -.06em;
}

.sb-detail-outcomes,
.sb-detail-missions,
.sb-related-grid {
    display: grid;
    gap: 14px;
}

.sb-detail-outcomes {
    grid-template-columns: repeat(2, minmax(0, 1fr));
}

.sb-detail-outcomes article,
.sb-detail-missions article,
.sb-related-grid a {
    min-width: 0;
    border: 1px solid rgba(255,255,255,.10);
    border-radius: 24px;
    padding: 18px;
    background:
        radial-gradient(circle at var(--mx, 50%) var(--my, 0%), color-mix(in srgb, var(--app-three) 16%, transparent), transparent 36%),
        rgba(255,255,255,.07);
    transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease, background .22s ease;
}

.sb-detail-outcomes article:hover,
.sb-detail-missions article:hover,
.sb-related-grid a:hover {
    transform: translateY(-6px);
    border-color: color-mix(in srgb, var(--app-three) 36%, white);
    background: rgba(255,255,255,.10);
    box-shadow: 0 24px 60px rgba(2,6,23,.34);
}

.sb-detail-outcomes article {
    display: flex;
    gap: 12px;
    align-items: center;
}

.sb-detail-outcomes span {
    flex: 0 0 auto;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: white;
    background: linear-gradient(135deg, var(--app-one), var(--app-two));
    font-weight: 950;
}

.sb-detail-outcomes strong,
.sb-detail-missions h3,
.sb-related-grid strong {
    color: white;
    overflow-wrap: anywhere;
}

.sb-detail-missions,
.sb-related-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
}

.sb-detail-missions article > span {
    color: var(--app-three);
    font-weight: 950;
}

.sb-detail-missions p {
    color: var(--sb-dark-muted);
}

.sb-related-grid a {
    color: white;
    text-decoration: none;
}

.sb-related-grid img {
    width: 100%;
    height: 145px;
    object-fit: contain;
    filter: drop-shadow(0 20px 28px rgba(0,0,0,.34));
}

.sb-related-grid strong,
.sb-related-grid span {
    display: block;
    overflow-wrap: anywhere;
}

.sb-related-grid span {
    color: var(--sb-dark-muted);
    margin-top: 4px;
}

@keyframes sbFloat {
    0%,100% { transform: translateY(0) rotate(-5deg); }
    50% { transform: translateY(-12px) rotate(7deg); }
}

@keyframes sbTwinkle {
    0%,100% { transform: scale(1); opacity: .72; }
    50% { transform: scale(1.12) rotate(8deg); opacity: 1; }
}

@media (max-width: 980px) {
    .sb-apps-landing,
    .sb-detail-hero,
    .sb-detail-section.split {
        grid-template-columns: 1fr;
    }

    .sb-connected-grid,
    .sb-detail-missions,
    .sb-related-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .sb-detail-strip,
    .sb-apps-toolbar {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 640px) {
    .sb-connected-grid,
    .sb-detail-outcomes,
    .sb-detail-missions,
    .sb-related-grid {
        grid-template-columns: 1fr;
    }

    .sb-apps-actions a,
    .sb-connected-links a,
    .sb-connected-links span {
        width: 100%;
    }

    .sb-apps-landing::before,
    .sb-detail-hero::before {
        inset: 8px;
        border-radius: 28px;
    }
}

@media (prefers-reduced-motion: reduce) {
    .sb-detail-decor,
    .sb-detail-art .spark {
        animation: none !important;
    }

    .sb-apps-actions a,
    .sb-connected-links a,
    .sb-connected-card,
    .sb-connected-media img,
    .sb-detail-outcomes article,
    .sb-detail-missions article,
    .sb-related-grid a {
        transition: none !important;
    }
}
