.sb-connected-apps,
.sb-app-detail-world,
.sb-connected-apps *,
.sb-app-detail-world * {
    box-sizing: border-box;
}

.sb-connected-apps,
.sb-app-detail-world {
    min-height: 100vh;
    overflow: hidden;
    color: #07111f;
    background:
        radial-gradient(circle at 0% 0%, rgba(34,211,238,.15), transparent 34%),
        radial-gradient(circle at 100% 4%, rgba(124,60,255,.13), transparent 34%),
        linear-gradient(180deg, #f7f9ff, #fff 42%, #f7f9ff);
}

.sb-apps-landing,
.sb-apps-toolbar,
.sb-apps-note,
.sb-connected-grid,
.sb-detail-hero,
.sb-detail-strip,
.sb-detail-section,
.sb-empty-apps {
    width: min(100%, 1180px);
    margin-inline: auto;
    padding-inline: clamp(16px, 4vw, 28px);
}

.sb-apps-landing,
.sb-detail-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, .72fr);
    gap: clamp(28px, 5vw, 56px);
    align-items: center;
    padding-top: clamp(44px, 8vw, 92px);
    padding-bottom: clamp(28px, 6vw, 66px);
}

.sb-apps-kicker {
    margin: 0 0 10px;
    color: var(--app-one, #7c3cff);
    font-size: .78rem;
    font-weight: 950;
    letter-spacing: .13em;
    text-transform: uppercase;
}

.sb-apps-landing h1,
.sb-detail-copy h1 {
    max-width: 820px;
    margin: 0;
    font-size: clamp(2.4rem, 7vw, 5.6rem);
    line-height: .88;
    letter-spacing: -.08em;
    overflow-wrap: anywhere;
}

.sb-apps-landing p,
.sb-detail-copy p,
.sb-detail-section p,
.sb-connected-card p {
    color: #5d6b7d;
    line-height: 1.72;
    overflow-wrap: anywhere;
}

.sb-apps-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
}

.sb-apps-actions a,
.sb-connected-links a,
.sb-connected-links span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    border-radius: 999px;
    padding: 11px 16px;
    color: white;
    background: linear-gradient(135deg, var(--app-one, #7c3cff), var(--app-two, #246bff));
    text-decoration: none;
    font-weight: 950;
    box-shadow: 0 18px 38px rgba(15,23,42,.14);
}

.sb-apps-actions .soft,
.sb-connected-links .soft {
    color: #07111f;
    background: rgba(255,255,255,.78);
}

.sb-apps-count-card {
    border: 1px solid rgba(255,255,255,.82);
    border-radius: 36px;
    padding: clamp(24px, 4vw, 38px);
    background: rgba(255,255,255,.7);
    box-shadow: 0 30px 80px rgba(15,23,42,.13);
    backdrop-filter: blur(18px);
    text-align: center;
}

.sb-apps-count-card span {
    font-size: 3rem;
}

.sb-apps-count-card strong {
    display: block;
    font-size: 4rem;
    line-height: .9;
}

.sb-apps-toolbar {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(160px, .55fr) minmax(160px, .55fr);
    gap: 14px;
    margin-bottom: 14px;
}

.sb-apps-toolbar label {
    display: grid;
    gap: 7px;
    min-width: 0;
    color: #64748b;
    font-size: .78rem;
    font-weight: 950;
    letter-spacing: .1em;
    text-transform: uppercase;
}

.sb-apps-toolbar input,
.sb-apps-toolbar select {
    min-width: 0;
    min-height: 52px;
    border: 1px solid rgba(15,23,42,.10);
    border-radius: 20px;
    padding: 0 14px;
    color: #07111f;
    background: rgba(255,255,255,.82);
    box-shadow: 0 14px 34px rgba(15,23,42,.06);
    font: inherit;
    font-weight: 850;
}

.sb-apps-note,
.sb-empty-apps {
    border: 1px solid rgba(15,23,42,.08);
    border-radius: 24px;
    padding-block: 16px;
    margin-bottom: 22px;
    background: rgba(255,255,255,.78);
    box-shadow: 0 18px 44px rgba(15,23,42,.06);
}

.sb-connected-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    padding-bottom: 40px;
}

.sb-connected-card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid rgba(15,23,42,.08);
    border-radius: 34px;
    background:
        radial-gradient(circle at var(--mx, 50%) var(--my, 0%), rgba(34,211,238,.18), transparent 36%),
        rgba(255,255,255,.86);
    box-shadow: 0 24px 64px rgba(15,23,42,.09);
    transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease;
}

.sb-connected-card:hover {
    transform: translateY(-7px);
    border-color: rgba(34,211,238,.28);
    box-shadow: 0 34px 82px rgba(15,23,42,.14);
}

.sb-connected-media {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 230px;
    padding: 24px;
    background:
        radial-gradient(circle at 50% 50%, var(--app-three), transparent 48%),
        linear-gradient(135deg, color-mix(in srgb, var(--app-one) 14%, white), color-mix(in srgb, var(--app-two) 10%, white));
}

.sb-connected-media img {
    position: relative;
    z-index: 1;
    width: min(100%, 210px);
    height: 190px;
    object-fit: contain;
    filter: drop-shadow(0 22px 28px rgba(15,23,42,.15));
}

.sb-connected-media > span {
    position: absolute;
    right: 18px;
    top: 18px;
    z-index: 2;
    min-width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: 18px;
    color: white;
    background: linear-gradient(135deg, var(--app-one), var(--app-two));
    font-weight: 950;
}

.sb-connected-card-body {
    padding: 22px;
}

.sb-connected-topline,
.sb-connected-meta,
.sb-role-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.sb-connected-topline {
    justify-content: space-between;
    align-items: center;
    color: var(--app-one);
    font-size: .76rem;
    font-weight: 950;
    letter-spacing: .1em;
    text-transform: uppercase;
}

.sb-connected-topline b,
.sb-connected-meta span,
.sb-role-chips span {
    border-radius: 999px;
    padding: 7px 9px;
    background: rgba(15,23,42,.06);
    color: #475569;
    font-size: .75rem;
    font-weight: 900;
}

.sb-connected-card h2 {
    margin: 14px 0 6px;
    font-size: 1.65rem;
    letter-spacing: -.04em;
}

.sb-connected-card .tagline {
    margin: 0 0 8px;
    color: #07111f;
    font-weight: 950;
}

.sb-connected-meta {
    margin-top: 14px;
}

.sb-connected-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
}

.sb-connected-card[hidden],
.sb-empty-apps[hidden] {
    display: none !important;
}

/* Detail page */
.sb-detail-hero {
    background: linear-gradient(180deg, var(--app-soft), transparent);
}

.sb-back-link {
    display: inline-flex;
    margin-bottom: 18px;
    border-radius: 999px;
    padding: 10px 14px;
    color: #07111f;
    background: rgba(255,255,255,.78);
    text-decoration: none;
    font-weight: 950;
}

.sb-world-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
}

.sb-world-meta span {
    border-radius: 999px;
    padding: 10px 13px;
    color: #07111f;
    background: rgba(255,255,255,.74);
    font-weight: 900;
}

.sb-detail-art {
    position: relative;
    min-height: clamp(340px, 44vw, 500px);
    display: grid;
    place-items: center;
    border: 1px solid rgba(255,255,255,.86);
    border-radius: clamp(32px, 5vw, 54px);
    padding: clamp(24px, 4vw, 42px);
    background:
        radial-gradient(circle at var(--mx, 60%) var(--my, 20%), rgba(34,211,238,.18), transparent 34%),
        rgba(255,255,255,.74);
    box-shadow: 0 34px 90px rgba(15,23,42,.16);
    backdrop-filter: blur(20px);
    transform-style: preserve-3d;
}

.sb-detail-art .main-art {
    position: relative;
    z-index: 2;
    width: min(100%, 400px);
    height: clamp(230px, 35vw, 400px);
    object-fit: contain;
    filter: drop-shadow(0 28px 38px rgba(15,23,42,.16));
}

.sb-detail-art > span {
    position: absolute;
    top: 22px;
    right: 22px;
    z-index: 3;
    min-width: 56px;
    height: 56px;
    display: grid;
    place-items: center;
    border-radius: 20px;
    color: white;
    background: linear-gradient(135deg, var(--app-one), var(--app-two));
    font-weight: 950;
}

.sb-detail-art .float,
.sb-detail-decor {
    position: absolute;
    object-fit: contain;
    pointer-events: none;
}

.sb-detail-art .orb {
    width: 110px;
    left: 14px;
    bottom: 20px;
}

.sb-detail-art .small-orb {
    width: 70px;
    right: 24px;
    bottom: 28px;
}

.sb-detail-art .spark {
    width: 54px;
    left: 18%;
    top: 14%;
    animation: sbFloat 4s ease-in-out infinite;
}

.sb-detail-decor.comet {
    width: clamp(120px, 22vw, 260px);
    right: 22%;
    top: 8%;
    opacity: .7;
}

.sb-detail-decor.star {
    width: 66px;
    left: 45%;
    top: 14%;
    animation: sbTwinkle 3s ease-in-out infinite;
}

.sb-detail-decor.planet {
    width: 116px;
    right: -22px;
    bottom: 14%;
}

.sb-detail-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin-bottom: 30px;
}

.sb-detail-strip article,
.sb-detail-section {
    border: 1px solid rgba(15,23,42,.08);
    background: rgba(255,255,255,.80);
    box-shadow: 0 24px 64px rgba(15,23,42,.08);
    backdrop-filter: blur(18px);
}

.sb-detail-strip article {
    min-width: 0;
    border-radius: 26px;
    padding: 18px;
}

.sb-detail-strip span {
    color: #64748b;
    font-size: .78rem;
    font-weight: 950;
    letter-spacing: .1em;
    text-transform: uppercase;
}

.sb-detail-strip strong {
    display: block;
    margin-top: 7px;
    overflow-wrap: anywhere;
}

.sb-detail-section {
    margin-bottom: 22px;
    border-radius: 34px;
    padding: clamp(24px, 4vw, 42px);
}

.sb-detail-section.split {
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
    gap: clamp(20px, 4vw, 40px);
}

.sb-detail-section h2 {
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 3.1rem);
    line-height: .95;
    letter-spacing: -.06em;
}

.sb-detail-outcomes,
.sb-detail-missions,
.sb-related-grid {
    display: grid;
    gap: 14px;
}

.sb-detail-outcomes {
    grid-template-columns: repeat(2, minmax(0, 1fr));
}

.sb-detail-outcomes article,
.sb-detail-missions article,
.sb-related-grid a {
    min-width: 0;
    border: 1px solid rgba(15,23,42,.08);
    border-radius: 24px;
    padding: 18px;
    background:
        radial-gradient(circle at var(--mx, 50%) var(--my, 0%), rgba(34,211,238,.14), transparent 36%),
        #fff;
    transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease;
}

.sb-detail-outcomes article:hover,
.sb-detail-missions article:hover,
.sb-related-grid a:hover {
    transform: translateY(-6px);
    border-color: rgba(34,211,238,.26);
    box-shadow: 0 24px 54px rgba(15,23,42,.12);
}

.sb-detail-outcomes article {
    display: flex;
    gap: 12px;
    align-items: center;
}

.sb-detail-outcomes span {
    flex: 0 0 auto;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: white;
    background: linear-gradient(135deg, var(--app-one), var(--app-two));
    font-weight: 950;
}

.sb-detail-missions,
.sb-related-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
}

.sb-detail-missions article > span {
    color: var(--app-one);
    font-weight: 950;
}

.sb-related-grid a {
    color: #07111f;
    text-decoration: none;
}

.sb-related-grid img {
    width: 100%;
    height: 145px;
    object-fit: contain;
    filter: drop-shadow(0 18px 24px rgba(15,23,42,.10));
}

.sb-related-grid strong,
.sb-related-grid span {
    display: block;
    overflow-wrap: anywhere;
}

.sb-related-grid span {
    color: #64748b;
    margin-top: 4px;
}

@keyframes sbFloat {
    0%,100% { transform: translateY(0) rotate(-5deg); }
    50% { transform: translateY(-12px) rotate(7deg); }
}

@keyframes sbTwinkle {
    0%,100% { transform: scale(1); opacity: .72; }
    50% { transform: scale(1.12) rotate(8deg); opacity: 1; }
}

@media (max-width: 980px) {
    .sb-apps-landing,
    .sb-detail-hero,
    .sb-detail-section.split {
        grid-template-columns: 1fr;
    }

    .sb-connected-grid,
    .sb-detail-missions,
    .sb-related-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .sb-detail-strip,
    .sb-apps-toolbar {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 640px) {
    .sb-connected-grid,
    .sb-detail-outcomes,
    .sb-detail-missions,
    .sb-related-grid {
        grid-template-columns: 1fr;
    }

    .sb-apps-actions a,
    .sb-connected-links a,
    .sb-connected-links span {
        width: 100%;
    }
}
